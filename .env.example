# ==============================================================================
# GANDHIDHAM MUNICIPAL CORPORATION (GMC) - CCMS ENVIRONMENT CONFIGURATION
# Seva First Hackathon 2026 - Government of Gujarat
# ==============================================================================

# 1. Supabase Cloud Database & Authentication (Optional for Live Mode)
# Leave blank to run in local demonstration mode with pre-seeded accounts.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Privileged service role key (MUST NEVER be exposed to frontend; server-side bridge only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. MQTT Broker Credentials (For persistent Node.js IoT Bridge)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=GMC-CCMS-SERVER-BRIDGE

# 3. CCMS Backend API Gateway
VITE_CCMS_API_BASE_URL=http://localhost:3001/api/iot

# 4. Default Municipal Tariffs
VITE_DEFAULT_TARIFF_PER_KWH=7.20

